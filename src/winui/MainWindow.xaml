<Window
    x:Class="PS2DriveForge.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PS2DriveForge.WinUI"
    Title="PS2 DriveForge - Frieren">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Padding="16,0,148,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="28" Height="28" Background="{StaticResource DriveForgeAccentBrush}" CornerRadius="7"><FontIcon Glyph="&#xE7F8;" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock Text="PS2 DriveForge" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border x:Name="VersionBadge" Background="{StaticResource DriveForgeAccentSubtleBrush}" CornerRadius="6" Padding="7,2"><TextBlock Text="Frieren 0.6-dev" FontSize="10" FontWeight="SemiBold"/></Border>
            </StackPanel>
            <Border x:Name="ReadOnlyBadge" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource DriveForgeCautionBackgroundBrush}" CornerRadius="12" Padding="9,3">
                <StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE72E;" FontSize="10" Foreground="{StaticResource DriveForgeCautionBrush}"/><TextBlock Text="READ SOURCE / GUARDED WRITES" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource DriveForgeCautionBrush}"/></StackPanel>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="OpenImageButton" Style="{StaticResource DriveForgeIconButtonStyle}" ToolTipService.ToolTip="Open disk image"><FontIcon Glyph="&#xE8E5;" FontSize="15"/></Button>
                <Button x:Name="RescanButton" Style="{StaticResource DriveForgeIconButtonStyle}" ToolTipService.ToolTip="Rescan PS2 drives"><FontIcon Glyph="&#xE72C;" FontSize="15"/></Button>
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Navigation" Grid.Row="1" Background="Transparent" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" PaneDisplayMode="Auto" IsPaneOpen="True" OpenPaneLength="190" CompactPaneLength="48" IsPaneToggleButtonVisible="True">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="HDD Manager" Tag="drive" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7F8;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="HDL Tools" Tag="hdl-tools"><NavigationViewItem.Icon><FontIcon Glyph="&#xE74D;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Files" Tag="files"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Mount" Tag="mount"><NavigationViewItem.Icon><FontIcon Glyph="&#xEDA2;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Performance" Tag="performance"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;"/></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <InfoBar x:Name="AccessInfoBar" Grid.Row="0" IsOpen="False" Severity="Warning" Title="Raw disk access needs Administrator privileges" Message="DriveForge can still open disk images. Restart elevated to scan physical PS2 HDDs." Margin="18,12,18,10"><InfoBar.ActionButton><Button x:Name="RestartAdminInfoButton" Content="Restart as Administrator"/></InfoBar.ActionButton></InfoBar>

                <ContentControl x:Name="HddPage" Grid.Row="1" Style="{StaticResource DriveForgeResponsivePageHostStyle}">
                    <Grid x:Name="HddContent" Padding="24,20,24,28" MaxWidth="1560" HorizontalAlignment="Center">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16"><TextBlock Text="HDD Manager" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock Text="APA appears first; HDL metadata is enriched in the background. Normal browsing stays read-only." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><StackPanel x:Name="HddHeaderActions" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"><Button x:Name="MountButton" Content="Mount read-only" Style="{StaticResource DriveForgeToolbarButtonStyle}" IsEnabled="False"/><Button x:Name="OpenExplorerButton" Content="Open in Explorer" Style="{StaticResource DriveForgeToolbarButtonStyle}" IsEnabled="False"/></StackPanel></StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource DriveForgeCardStyle}" Margin="0,0,0,12"><Grid ColumnSpacing="14" RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource DriveForgeAccentSubtleBrush}"><FontIcon Glyph="&#xEDA2;" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Source" Style="{StaticResource DriveForgeMetricLabelStyle}"/><TextBlock x:Name="SourceNameText" Text="No PS2 HDD opened" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SourceDetailText" Text="Scanning starts automatically" Style="{StaticResource DriveForgeCaptionStyle}" TextTrimming="CharacterEllipsis"/></StackPanel><Border Grid.Column="2" CornerRadius="10" Padding="8,3" Background="{ThemeResource ControlFillColorSecondaryBrush}"><TextBlock x:Name="SourceMediaText" Text="waiting" Style="{StaticResource DriveForgeCaptionStyle}"/></Border><StackPanel Grid.Row="1" Grid.ColumnSpan="3" Spacing="8"><ComboBox x:Name="DriveSelector" MinWidth="200" PlaceholderText="Detected PS2 HDDs" HorizontalAlignment="Stretch"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="OpenDriveButton" Content="Open selected" Style="{StaticResource DriveForgeToolbarButtonStyle}" IsEnabled="False"/><Button x:Name="OpenImageInlineButton" Content="Open image" Style="{StaticResource DriveForgeToolbarButtonStyle}"/><Button x:Name="ScanDrivesButton" Content="Scan drives" Style="{StaticResource DriveForgeToolbarButtonStyle}"/></StackPanel></StackPanel></Grid></Border>
                        <ItemsControl Grid.Row="2" Margin="0,0,0,12"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="210" ItemHeight="92"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><Border Style="{StaticResource DriveForgeCardStyle}" Margin="0,0,10,10"><StackPanel Spacing="4"><TextBlock Text="APA rows" Style="{StaticResource DriveForgeMetricLabelStyle}"/><TextBlock x:Name="ApaRowsText" Text="-" Style="{StaticResource DriveForgeMetricValueStyle}"/><TextBlock Text="zero-I/O catalog" Style="{StaticResource DriveForgeCaptionStyle}"/></StackPanel></Border><Border Style="{StaticResource DriveForgeCardStyle}" Margin="0,0,10,10"><StackPanel Spacing="4"><TextBlock Text="HDL games" Style="{StaticResource DriveForgeMetricLabelStyle}"/><TextBlock x:Name="HdlGamesText" Text="-" Style="{StaticResource DriveForgeMetricValueStyle}"/><TextBlock x:Name="EnrichmentStateText" Text="metadata idle" Style="{StaticResource DriveForgeCaptionStyle}"/></StackPanel></Border><Border Style="{StaticResource DriveForgeCardStyle}" Margin="0,0,10,10"><StackPanel Spacing="4"><TextBlock Text="Backing I/O" Style="{StaticResource DriveForgeMetricLabelStyle}"/><TextBlock x:Name="BackingReadsText" Text="-" Style="{StaticResource DriveForgeMetricValueStyle}"/><TextBlock Text="reads this session" Style="{StaticResource DriveForgeCaptionStyle}"/></StackPanel></Border><Border Style="{StaticResource DriveForgeCardStyle}" Margin="0,0,10,10"><StackPanel Spacing="4"><TextBlock Text="Source size" Style="{StaticResource DriveForgeMetricLabelStyle}"/><TextBlock x:Name="SourceSizeText" Text="-" Style="{StaticResource DriveForgeMetricValueStyle}"/><TextBlock Text="reported capacity" Style="{StaticResource DriveForgeCaptionStyle}"/></StackPanel></Border></ItemsControl>
                        <Border Grid.Row="3" Style="{StaticResource DriveForgeCompactCardStyle}" Margin="0,0,0,12"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource DriveForgeAccentSubtleBrush}"><FontIcon Glyph="&#xE895;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Spacing="5"><Grid><TextBlock Text="Game metadata enrichment" Style="{StaticResource DriveForgeSectionTitleStyle}"/><TextBlock x:Name="EnrichmentProgressText" Text="Waiting for a source" HorizontalAlignment="Right" Style="{StaticResource DriveForgeCaptionStyle}"/></Grid><ProgressBar x:Name="EnrichmentProgress" Minimum="0" Maximum="1" Value="0" Height="3"/></StackPanel><Button Grid.Column="2" x:Name="CancelEnrichmentButton" Content="Cancel" IsEnabled="False" Style="{StaticResource DriveForgeToolbarButtonStyle}"/></Grid></Border>
                        <Grid x:Name="HddWorkspace" Grid.Row="4" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Grid.Row="0" Style="{StaticResource DriveForgeCardStyle}" Padding="0" MinHeight="390"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Padding="14,12" ColumnSpacing="8" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FilterBox" Grid.ColumnSpan="3" PlaceholderText="Search title, startup ID or partition..."/><ComboBox x:Name="PartitionKindFilter" Grid.Row="1" SelectedIndex="0" MinWidth="126"><ComboBoxItem Content="All partitions"/><ComboBoxItem Content="HDL games"/><ComboBoxItem Content="PFS"/><ComboBoxItem Content="System"/></ComboBox><ToggleSwitch x:Name="ShowSubsToggle" Grid.Row="1" Grid.Column="1" Header="Sub-partitions" IsOn="True"/><Button x:Name="RefreshMetadataButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource DriveForgeIconButtonStyle}" ToolTipService.ToolTip="Refresh metadata"><FontIcon Glyph="&#xE72C;"/></Button></Grid><Grid Grid.Row="1" Padding="14,0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="2.4*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions><TextBlock Text="Title / partition" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Startup" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="Type" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="Allocated" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="LBA" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="5" Text="State" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid><Grid Grid.Row="2" MinHeight="300"><ListView x:Name="PartitionList" SelectionMode="Single" HorizontalContentAlignment="Stretch" Background="Transparent"/><StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"><TextBlock Text="Open a PS2 HDD or disk image" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="DriveForge publishes the APA catalog first and enriches HDL metadata afterward." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Grid></Grid></Border><ItemsControl Grid.Row="1"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="280" ItemHeight="118"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><Border Style="{StaticResource DriveForgeCardStyle}" Margin="0,0,10,10"><StackPanel Spacing="8"><TextBlock Text="Storage profile" Style="{StaticResource DriveForgeSectionTitleStyle}"/><TextBlock x:Name="MediaClassText" Text="Media: Unknown" Style="{StaticResource DriveForgeCaptionStyle}"/><TextBlock x:Name="BusTypeText" Text="Bus: -" Style="{StaticResource DriveForgeCaptionStyle}"/><TextBlock x:Name="SeekPenaltyText" Text="Seek penalty: Unknown" Style="{StaticResource DriveForgeCaptionStyle}"/><TextBlock x:Name="TrimText" Text="TRIM: Unknown" Style="{StaticResource DriveForgeCaptionStyle}"/></StackPanel></Border><Border Style="{StaticResource DriveForgeCardStyle}" Margin="0,0,10,10"><StackPanel Spacing="8"><TextBlock Text="Performance" Style="{StaticResource DriveForgeSectionTitleStyle}"/><TextBlock x:Name="ApaScanTimeText" Text="APA scan: -" Style="{StaticResource DriveForgeCaptionStyle}"/><TextBlock x:Name="CatalogBuildTimeText" Text="Catalog build: -" Style="{StaticResource DriveForgeCaptionStyle}"/><TextBlock x:Name="AverageReadText" Text="Avg. backing read: -" Style="{StaticResource DriveForgeCaptionStyle}"/></StackPanel></Border><Border Style="{StaticResource DriveForgeCardStyle}" Margin="0,0,10,10"><StackPanel Spacing="8"><TextBlock Text="Safety" Style="{StaticResource DriveForgeSectionTitleStyle}"/><TextBlock Text="Read sessions use ordinary read-only PhysicalDrive" Style="{StaticResource DriveForgeCaptionStyle}"/><TextBlock Text="Writes require a separate guarded capability" Style="{StaticResource DriveForgeCaptionStyle}"/><TextBlock Text="Explorer mount rejects mutations" Style="{StaticResource DriveForgeCaptionStyle}"/></StackPanel></Border></ItemsControl></Grid>
                    </Grid>
                </ContentControl>

                <ContentControl x:Name="HdlToolsPage" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource DriveForgeResponsivePageHostStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Padding="24,20,24,28" MaxWidth="1120" HorizontalAlignment="Center" RowSpacing="12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Spacing="4"><TextBlock Text="HDL Tools" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock Text="Pick a PS2 ISO and install it. DriveForge reads SYSTEM.CNF, detects media, resolves the game database and stages OPL metadata automatically." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
                            <InfoBar x:Name="HdlToolsInfoBar" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="0,4,0,0"/>

                            <Border Grid.Row="2" Style="{StaticResource DriveForgeCompactCardStyle}"><StackPanel Spacing="4"><TextBlock Text="Current target" Style="{StaticResource DriveForgeMetricLabelStyle}"/><TextBlock x:Name="HdlToolSourceText" Text="No source" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="HdlToolSafetyText" Text="Open a PS2 HDD or disk image first." Style="{StaticResource DriveForgeCaptionStyle}" TextWrapping="Wrap"/></StackPanel></Border>

                            <Border Grid.Row="3" Style="{StaticResource DriveForgeCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Install game" FontSize="20" FontWeight="SemiBold"/>
                                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="HdlIsoPathText" IsReadOnly="True" PlaceholderText="Select a PS2 ISO" TextChanged="on_hdl_iso_path_changed"/><Button x:Name="HdlChooseIsoButton" Grid.Column="1" Content="Choose ISO..."/></Grid>

                                    <Border Style="{StaticResource DriveForgeCompactCardStyle}">
                                        <StackPanel Spacing="5">
                                            <TextBlock x:Name="HdlMetadataSummaryText" Text="Choose an ISO. Metadata and artwork will be prepared automatically." FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="HdlDetectedMediaText" Text="Startup / media: -" Style="{StaticResource DriveForgeCaptionStyle}" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="HdlMetadataDetailsText" Text="Database: waiting" Style="{StaticResource DriveForgeCaptionStyle}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBox x:Name="HdlTitleBox" Header="Game title" PlaceholderText="Filled from the game database automatically"/>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="HdlInstallButton" Content="Install game" IsEnabled="False"/>
                                    </StackPanel>

                                    <Border Style="{StaticResource DriveForgeCompactCardStyle}"><StackPanel Spacing="5"><TextBlock x:Name="HdlPreviewStateText" Text="No install plan" FontWeight="SemiBold"/><TextBlock x:Name="HdlPreviewStartupText" Text="Startup: -" Style="{StaticResource DriveForgeCaptionStyle}"/><TextBlock x:Name="HdlPreviewPartitionText" Text="Partition: -" Style="{StaticResource DriveForgeCaptionStyle}" TextWrapping="Wrap"/><TextBlock x:Name="HdlPreviewAllocationText" Text="Allocation: -" Style="{StaticResource DriveForgeCaptionStyle}" TextWrapping="Wrap"/><TextBlock x:Name="HdlPreviewTargetText" Text="Target: -" Style="{StaticResource DriveForgeCaptionStyle}" TextWrapping="Wrap"/><ProgressBar x:Name="HdlInstallProgress" Minimum="0" Maximum="1" Value="0" Height="4"/><TextBlock x:Name="HdlInstallProgressText" Text="Idle" Style="{StaticResource DriveForgeCaptionStyle}"/></StackPanel></Border>

                                    <Expander Header="Advanced install options" IsExpanded="False">
                                        <StackPanel Spacing="10" Padding="0,8,0,0">
                                            <TextBlock Text="Normal installs do not need these controls. Media is detected automatically and safety files use a DriveForge-managed folder." Style="{StaticResource DriveForgeCaptionStyle}" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Spacing="14"><ComboBox x:Name="HdlMediaPicker" Header="Media override" SelectedIndex="0" MinWidth="150"><ComboBoxItem Content="DVD"/><ComboBoxItem Content="CD"/></ComboBox><ToggleSwitch x:Name="HdlHiddenToggle" Header="Hidden HDL partition"/></StackPanel>
                                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="HdlArtifactPathText" IsReadOnly="True" PlaceholderText="Automatic safety / recovery directory"/><Button x:Name="HdlChooseArtifactButton" Grid.Column="1" Content="Change..."/></Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="HdlRefreshMetadataButton" Content="Refresh online metadata" Click="on_refresh_hdl_online_metadata"/><Button x:Name="HdlPreviewButton" Content="Refresh install plan" IsEnabled="False"/></StackPanel>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="4" Style="{StaticResource DriveForgeCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Installed HDL games" FontSize="18" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="HdlGamePicker" PlaceholderText="Select installed game" HorizontalAlignment="Stretch"/>
                                    <Button x:Name="HdlDeleteSelectedButton" Content="Delete selected game" IsEnabled="False" HorizontalAlignment="Left"/>

                                    <Expander Header="Advanced bootstrap, diagnostics and recovery" IsExpanded="False" Margin="0,8,0,0">
                                        <StackPanel Spacing="12" Padding="0,8,0,0">
                                            <Border Style="{StaticResource DriveForgeCompactCardStyle}">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Physical write diagnostics" FontWeight="SemiBold"/><TextBlock x:Name="PhysicalGateText" Text="Physical write gate: not applicable" Style="{StaticResource DriveForgeCaptionStyle}" TextWrapping="Wrap"/><TextBlock x:Name="PhysicalFingerprintText" Text="Fingerprint: -" Style="{StaticResource DriveForgeCaptionStyle}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/></StackPanel><Button x:Name="PhysicalPreflightButton" Grid.Column="1" Content="Physical preflight" IsEnabled="False"/></Grid>
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource DriveForgeCompactCardStyle}">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="Bootstrap provider install" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Expert path for verified bootstrap KELFs. Normal game installation does not require manifests, MagicGate keysets or ICVPS2 evidence." Style="{StaticResource DriveForgeCaptionStyle}" TextWrapping="Wrap"/>
                                                    <Grid ColumnSpacing="8" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ProviderManifestPathText" IsReadOnly="True" PlaceholderText="Local provider manifest"/><Button Grid.Column="1" Content="Manifest..." Click="on_choose_provider_manifest"/><TextBox x:Name="ProviderKeysetPathText" Grid.Row="1" IsReadOnly="True" PlaceholderText="Local MagicGate keyset"/><Button Grid.Row="1" Grid.Column="1" Content="Keyset..." Click="on_choose_provider_keyset"/><TextBox x:Name="ProviderIcvps2Box" Grid.Row="2" Header="ICVPS2 evidence (only when required)" PlaceholderText="16 hex characters" MaxLength="16"/><TextBox x:Name="ProviderIcvps2ProvenanceBox" Grid.Row="3" Header="ICVPS2 provenance" PlaceholderText="MechaCon capture / trusted reference"/></Grid>
                                                    <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ProviderStageButton" Content="Stage and verify" Click="on_stage_provider"/><Button x:Name="ProviderInstallButton" Content="Install frozen provider" Click="on_install_provider" IsEnabled="False"/></StackPanel>
                                                    <TextBlock x:Name="ProviderPreviewText" Text="No provider staged." Style="{StaticResource DriveForgeCaptionStyle}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource DriveForgeCompactCardStyle}">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="FHDB and APA recovery" FontWeight="SemiBold"/>
                                                    <TextBlock Text="Recovery is intentionally separate from normal game management. Read-only evidence actions and guarded repairs remain available here." Style="{StaticResource DriveForgeCaptionStyle}" TextWrapping="Wrap"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="CaptureRescueButton" Content="Create Rescue Capsule" Click="on_capture_rescue"/><Button x:Name="RestoreRescueButton" Content="Restore Rescue / legacy backup" Click="on_restore_rescue"/><Button x:Name="ForensicAnalyzeButton" Content="Forensic APA analysis" Click="on_forensic_analyze"/></StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="RepairMasterButton" Content="Repair APA master" Click="on_repair_master"/><Button x:Name="RepairForensicButton" Content="Apply automatic-safe topology repair" Click="on_repair_forensic"/></StackPanel>
                                                    <TextBlock Text="Manual-only forensic maps remain unavailable from WinUI." Style="{StaticResource DriveForgeCaptionStyle}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </ContentControl>

                <ContentControl x:Name="FilesPage" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource DriveForgeResponsivePageHostStyle}"><Grid Padding="24,20,24,28" MaxWidth="1400" HorizontalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Files" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock Grid.Row="1" Margin="0,4,0,16" Text="Browse PFS partitions through the cached read-only DriveSession." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Border Grid.Row="2" Style="{StaticResource DriveForgeCompactCardStyle}" Margin="0,0,0,12"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="PfsPartitionPicker" MinWidth="180" PlaceholderText="PFS partition"/><TextBlock x:Name="FilesPathText" Grid.Column="1" Text="/" VerticalAlignment="Center"/><Button x:Name="FilesUpButton" Grid.Column="2" Content="Up" IsEnabled="False"/><Button x:Name="ExportButton" Grid.Column="3" Content="Export selected" IsEnabled="False"/></Grid></Border><Border Grid.Row="3" Style="{StaticResource DriveForgeCardStyle}" Padding="0" MinHeight="430"><ListView x:Name="FilesList" SelectionMode="Single" HorizontalContentAlignment="Stretch" Background="Transparent"/></Border></Grid></ContentControl>
                <ContentControl x:Name="MountPage" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource DriveForgeResponsivePageHostStyle}"><Grid Padding="24,20,24,28" MaxWidth="980" HorizontalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Mount" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock Grid.Row="1" Margin="0,4,0,16" Text="Expose the current source in Explorer through the read-only Dokany helper." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Border Grid.Row="2" Style="{StaticResource DriveForgeCardStyle}"><StackPanel Spacing="14"><TextBlock x:Name="MountStatusText" Text="Nothing mounted" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="MountPointText" Text="Drive letter: automatic"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="MountPageMountButton" Content="Mount read-only" IsEnabled="False"/><Button x:Name="MountPageExplorerButton" Content="Open in Explorer" IsEnabled="False"/><Button x:Name="UnmountButton" Content="Unmount" IsEnabled="False"/></StackPanel></StackPanel></Border></Grid></ContentControl>
                <ContentControl x:Name="PerformancePage" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource DriveForgeResponsivePageHostStyle}"><Grid Padding="24,20,24,28" MaxWidth="1100" HorizontalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Performance" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock Grid.Row="1" Margin="0,4,0,16" Text="Live counters from the shared instrumented read-only I/O pipeline." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Border Grid.Row="2" Style="{StaticResource DriveForgeCardStyle}"><StackPanel Spacing="10"><TextBlock x:Name="PerfSourceText" Text="No source" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="PerfApaText" Text="APA scan: -"/><TextBlock x:Name="PerfCatalogText" Text="Catalog build: -"/><TextBlock x:Name="PerfReadsText" Text="Backing reads: -"/><TextBlock x:Name="PerfBytesText" Text="Backing bytes: -"/><TextBlock x:Name="PerfAvgText" Text="Average backing read: -"/><TextBlock x:Name="PerfCacheText" Text="Cache: -"/><Button x:Name="ResetStatsButton" Content="Reset counters" HorizontalAlignment="Left"/></StackPanel></Border></Grid></ContentControl>
