<Window
    x:Class="PS2DriveForge.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PS2DriveForge.WinUI"
    Title="PS2 DriveForge — Emilia">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarDragRegion" Grid.Row="0" Padding="16,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7F8;" FontSize="18"/>
                <TextBlock Text="PS2 DriveForge" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="5" Padding="7,2">
                    <TextBlock Text="0.5 Emilia" FontSize="11"/>
                </Border>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="READ ONLY" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                       FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="OpenImageButton" ToolTipService.ToolTip="Open disk image">
                    <FontIcon Glyph="&#xE8E5;"/>
                </Button>
                <Button x:Name="RescanButton" ToolTipService.ToolTip="Rescan PS2 drives">
                    <FontIcon Glyph="&#xE72C;"/>
                </Button>
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True" PaneDisplayMode="LeftCompact"
                        OpenPaneLength="220" IsPaneToggleButtonVisible="True">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Drive" Tag="drive">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F8;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Files" Tag="files">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Mount" Tag="mount">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEDA2;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Performance" Tag="performance">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Padding="24,20,24,28" MaxWidth="1500" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="HDD Manager" Style="{ThemeResource TitleTextBlockStyle}"/>
                            <TextBlock Text="APA list first. Game metadata arrives progressively — no modal scan wall."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Mount read-only"/>
                            <Button Content="Open in Explorer"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="12" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Source" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                <TextBlock x:Name="SourceNameText" Text="No PS2 HDD opened" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SourceDetailText" Text="Automatic discovery is handled by the shared native host"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="5">
                                <TextBlock Text="APA rows" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                <TextBlock x:Name="ApaRowsText" Text="—" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="zero-I/O catalog" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="5">
                                <TextBlock Text="HDL games" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                <TextBlock x:Name="HdlGamesText" Text="—" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock x:Name="EnrichmentStateText" Text="metadata idle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Backing I/O" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                <TextBlock x:Name="BackingReadsText" Text="—" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="reads this session" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="14"
                            Margin="0,0,0,12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock Text="Game metadata enrichment" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="EnrichmentProgressText" Text="Waiting for a source"
                                               HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                </Grid>
                                <ProgressBar x:Name="EnrichmentProgress" Minimum="0" Maximum="1" Value="0"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="CancelEnrichmentButton" Content="Cancel" IsEnabled="False"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,0,0,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FilterBox" PlaceholderText="Filter by title, startup ID or partition…" QueryIcon="Find"/>
                        <ComboBox Grid.Column="1" SelectedIndex="0" MinWidth="140">
                            <ComboBoxItem Content="All partitions"/>
                            <ComboBoxItem Content="HDL games"/>
                            <ComboBoxItem Content="PFS"/>
                            <ComboBoxItem Content="System"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="Refresh metadata"/>
                    </Grid>

                    <Border Grid.Row="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Padding="14,0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.4*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Title / partition" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Startup" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Type" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Allocated" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="LBA" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="State" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>
                            <ListView x:Name="PartitionList" Grid.Row="1" SelectionMode="Extended" MinHeight="320">
                                <ListView.EmptyContent>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="20,60">
                                        <FontIcon Glyph="&#xE7F8;" FontSize="30" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="Open a PS2 HDD or image" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="The APA catalog appears first; optional HDL/PFS metadata is filled in afterward."
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center"/>
                                    </StackPanel>
                                </ListView.EmptyContent>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </NavigationView>

        <Grid Grid.Row="2" Padding="12,0" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready — source access is structurally read-only"
                       VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11"/>
            <TextBlock Grid.Column="1" Text="WinUI 3 / Windows App SDK 2.3.1"
                       VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11"/>
        </Grid>
    </Grid>
</Window>
